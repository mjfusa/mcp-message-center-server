{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "<azure-region>"
    },
    "namePrefix": {
      "value": "<name-prefix>"
    },
    "messageCenterImage": {
      "value": "<acrLoginServer (auto when using BuildTestDeploy.ps1 -ProvisionInfra)>/mcp-message-center-server:<tag>"
    },
    "minReplicas": {
      "value": 0
    },
    "maxReplicas": {
      "value": 5
    },
    "graphTenantId": {
      "value": "<tenant-guid>"
    },
    "graphClientId": {
      "value": "<app-client-id-guid>"
    },
    "keyVaultName": {
      "value": "<key-vault-name>"
    },
    "useExistingKeyVault": {
      "value": false
    },
    "existingKeyVaultResourceGroupName": {
      "value": ""
    },
    "graphClientCertSecretName": {
      "value": "<key-vault-secret-name>"
    },
    "graphClientCertThumbprint": {
      "value": "<cert-thumbprint-hex>"
    },
    "publicBaseUrl": {
      "value": ""
    },
    "acrUseManagedIdentity": {
      "value": true
    }
  }
}
